APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Lokal: true. Produksi WAJIB false — kalau true, pengunjung melihat stack trace Symfony, bukan halaman error ramah.
APP_DEBUG=true
APP_URL=http://localhost

# Domain lama yang dialihkan 301 ke APP_URL (pisahkan koma jika banyak)
LEGACY_REDIRECT_HOSTS=vehiclemanagement.online,www.vehiclemanagement.online

# Google Search Console — meta tag verification (HTML tag method)
GOOGLE_SITE_VERIFICATION=wLl4Mbp-UkmlhXLljmBiWlNZg3HtZy5kjb4PF3ThxG8

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telegram_finance_bot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lokal: log (email tidak benar-benar terkirim). Produksi VPS: pakai smtp.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Contoh produksi — Gmail (butuh App Password jika 2FA aktif):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=yfinancialdoctor@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=yfinancialdoctor@gmail.com
# MAIL_FROM_NAME="Your Financial Doctor"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# URL redirect setelah bayar (opsional). Jika Midtrans menolak, set false sementara untuk uji.
MIDTRANS_FINISH_URL=
MIDTRANS_USE_FINISH_CALLBACK=true
ADMIN_DASHBOARD_TOKEN=

# Pengiriman ringkasan setelah bayar (lisensi + dashboard web): wa | email | both
ORDER_DELIVERY_CHANNEL=email

# Fonnte WhatsApp API (https://fonnte.com) — token dari dashboard Fonnte
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_TOKEN=
FONNTE_TIMEOUT=30

# Tautan bot untuk WA/email pembeli & halaman checkout (WAJIB di produksi — salah satu)
# Username bot TANPA @ — dipakai untuk link t.me & tg:// di email/WA
# Contoh: TELEGRAM_BOT_USERNAME=YFD_Finance_Bot  →  https://t.me/YFD_Finance_Bot
# Cek username di @BotFather → /mybots → pilih bot → lihat @username
TELEGRAM_BOT_USERNAME=
# Opsional override URL penuh (harus https://t.me/UsernameBot)
TELEGRAM_BOT_URL=

# Token rahasia agar bot Python bisa panggil API internal Laravel
# (/api/bot/transactions, /api/bot/portal-link, /api/bot/ai-health)
# Generate sekali (copy hasil ke Laravel DAN bot-python .env):
#   php -r "echo bin2hex(random_bytes(32));"
BOT_INTERNAL_API_TOKEN=
