APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Domain lama yang dialihkan 301 ke APP_URL (pisahkan koma jika banyak)
LEGACY_REDIRECT_HOSTS=vehiclemanagement.online,www.vehiclemanagement.online

# Google Search Console — meta tag verification (HTML tag method)
GOOGLE_SITE_VERIFICATION=wLl4Mbp-UkmlhXLljmBiWlNZg3HtZy5kjb4PF3ThxG8

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telegram_finance_bot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lokal: log (email tidak benar-benar terkirim). Produksi VPS: pakai smtp.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Contoh produksi — Gmail (butuh App Password jika 2FA aktif):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=yfinancialdoctor@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=yfinancialdoctor@gmail.com
# MAIL_FROM_NAME="Your Financial Doctor"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# URL redirect setelah bayar (opsional). Jika Midtrans menolak, set false sementara untuk uji.
MIDTRANS_FINISH_URL=
MIDTRANS_USE_FINISH_CALLBACK=true
ADMIN_DASHBOARD_TOKEN=

# Duplikasi spreadsheet template per order
# 1) Upload shared/templates/master_finance_workbook.xlsx ke Google Drive sebagai Google Sheet
# 2) Salin ID dari URL: https://docs.google.com/spreadsheets/d/ID_INI/edit
# 3) Share template ke email service account (client_email di JSON) sebagai Editor
GOOGLE_SERVICE_ACCOUNT_JSON=/var/www/telegram-finance-bot/apps/admin-laravel/storage/app/google-service-account.json
GOOGLE_USER_SHEET_TEMPLATE_ID=
# ID folder Drive untuk salinan sementara (Shared drive yang hanya berisi service account = privasi admin terbaik)
GOOGLE_DRIVE_COPY_PARENT_ID=
# Nama tab di template (wajib ada di master Google Sheet)
GOOGLE_SHEET_TRANSACTION_TAB=Transaksi
GOOGLE_SHEET_DASHBOARD_TAB=Dashboard
# Setelah salin: pelanggan reader + transfer kepemilikan ke email order (sheet pindah ke Drive pelanggan)
# false = jangan transfer ownership (transfer ke Gmail luar sering gagal / menunggu approve)
GOOGLE_TRANSFER_SHEET_OWNERSHIP=false
# Jika share ke email checkout gagal, buka akses "siapa pun dengan link" (disarankan true)
GOOGLE_SHEET_FALLBACK_LINK_READER=true
GOOGLE_SHEET_ANYONE_WITH_LINK_READER=false
# Sembunyikan link sheet user di panel admin
GOOGLE_HIDE_USER_SHEET_FROM_ADMIN=true
# Tanpa Shared drive: salin sebagai akun Workspace (perlu domain-wide delegation di Admin)
GOOGLE_DRIVE_IMPERSONATE_USER=yfinancialdoctor@gmail.com
# Jika Admin tidak punya "Domain-wide delegation", pakai OAuth refresh token (lihat docs di README deploy):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Pengiriman ringkasan setelah bayar (lisensi + Google Sheet): wa | email | both
ORDER_DELIVERY_CHANNEL=email

# Fonnte WhatsApp API (https://fonnte.com) — token dari dashboard Fonnte
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_TOKEN=
FONNTE_TIMEOUT=30

# Tautan bot untuk WA/email pembeli & halaman checkout (WAJIB di produksi — salah satu)
# Contoh: TELEGRAM_BOT_USERNAME=YFD_Finance_Bot  →  https://t.me/YFD_Finance_Bot
# Atau: TELEGRAM_BOT_URL=https://t.me/YFD_Finance_Bot
# Bisa juga di admin: Site Settings → Integrasi Bot & Email → telegram.bot_url
TELEGRAM_BOT_URL=
TELEGRAM_BOT_USERNAME=

# Token untuk bot Python memanggil POST /api/bot/orders/{code}/ensure-sheet (sama di bot-python/.env)
BOT_INTERNAL_API_TOKEN=

# Jalankan sync_dashboard.py dari admin (default: python)
SYNC_DASHBOARD_PYTHON=python
# Detik maksimal satu kali sync (banyak user bisa lama)
SYNC_DASHBOARD_TIMEOUT=3600
