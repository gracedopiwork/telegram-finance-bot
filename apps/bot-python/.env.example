TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# CLAUDE_MODELS=claude-haiku-4-5,claude-sonnet-4-6
USER_ID=

# Lisensi — true = hanya user dengan /activate KODE yang ada di DB MySQL (sama dengan Laravel) yang bisa pakai bot
LICENSE_REQUIRED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=telegram_finance_bot

# Admin API
ADMIN_API_TOKEN=
ADMIN_PORT=8080

# Integrasi bot -> Laravel internal API (nilai HARUS sama dengan Laravel .env)
# Generate token: php -r "echo bin2hex(random_bytes(32));"
BOT_INTERNAL_API_TOKEN=
# URL publik situs Laravel (tanpa slash di akhir)
LARAVEL_APP_URL=https://your-domain.com
# Alternatif loopback nginx (VPS): isi KEDUA baris di bawah, kosongkan LARAVEL_APP_URL
# LARAVEL_APP_PATH=/var/www/telegram-finance-bot/apps/admin-laravel
# LARAVEL_APP_HOST=your-domain.com

AI_QUOTA_MONTHLY_IDR=5000
AI_COST_TEXT_PARSE_IDR=10
AI_COST_VISION_PARSE_IDR=30
