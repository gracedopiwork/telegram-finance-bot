TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GOOGLE_SHEET_NAME=
GOOGLE_SHEET_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
USER_ID=

# Lisensi — true = hanya user dengan /activate KODE yang ada di DB MySQL (sama dengan Laravel) yang bisa pakai bot
LICENSE_REQUIRED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=telegram_finance_bot

# Admin API
ADMIN_API_TOKEN=
ADMIN_PORT=8080

# Dashboard sync (hanya tab Dashboard; tab Transaksi tidak disentuh)
DASHBOARD_MASTER_SPREADSHEET_ID=
DASHBOARD_MASTER_SHEET_TITLE=Dashboard
GOOGLE_SHEET_TRANSACTION_TITLE=Transaksi
# WAJIB sama dengan Laravel — untuk share sheet + izin tulis service account (/catat)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# true = jika share ke email checkout gagal, izinkan buka lewat link (akun Google mana pun)
GOOGLE_SHEET_FALLBACK_LINK_READER=true
