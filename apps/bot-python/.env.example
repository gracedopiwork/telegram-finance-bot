TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GOOGLE_SHEET_NAME=
GOOGLE_SHEET_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
USER_ID=

# Lisensi — true = hanya user dengan /activate KODE yang ada di DB MySQL (sama dengan Laravel) yang bisa pakai bot
LICENSE_REQUIRED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=telegram_finance_bot

# Admin API
ADMIN_API_TOKEN=
ADMIN_PORT=8080

# Perbaikan izin sheet + laporan statistik AI ke admin (sama token di Laravel BOT_INTERNAL_API_TOKEN)
BOT_INTERNAL_API_TOKEN=
LARAVEL_APP_URL=https://your-domain.com
# Opsional jika LARAVEL_APP_URL kosong: path Laravel + host nginx (loopback)
# LARAVEL_APP_PATH=/var/www/telegram-finance-bot/apps/admin-laravel
# LARAVEL_APP_HOST=your-domain.com
# Alternatif di VPS tanpa URL publik: path ke apps/admin-laravel
LARAVEL_APP_PATH=

# Penyimpanan transaksi: db (default) | sheet | both
BOT_TRANSACTION_STORAGE=db

AI_QUOTA_MONTHLY_IDR=5000
AI_COST_TEXT_PARSE_IDR=10
AI_COST_VISION_PARSE_IDR=30

DASHBOARD_MASTER_SPREADSHEET_ID=
DASHBOARD_MASTER_SHEET_TITLE=Dashboard
GOOGLE_SHEET_TRANSACTION_TITLE=Transaksi
# Kosongkan GOOGLE_SHEET_NAME / GOOGLE_SHEET_URL di produksi (sheet per order dari DB)
# WAJIB sama dengan Laravel — untuk share sheet + izin tulis service account (/catat)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# true = jika share ke email checkout gagal, izinkan buka lewat link (akun Google mana pun)
GOOGLE_SHEET_FALLBACK_LINK_READER=true
